# Deprecated alias — prefer deploy/delivery-agent.service (unit name: delivery-agent)
[Unit]
Description=Delivery Agent
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=botuser
Group=botuser
WorkingDirectory=/opt/delivery-agent
EnvironmentFile=/opt/delivery-agent/.env
ExecStart=/opt/delivery-agent/.venv/bin/python -m bot.main
Restart=always
RestartSec=10
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
