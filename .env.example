# Lark 自建应用（https://open.larksuite.com/app）
LARK_APP_ID=cli_xxxxxxxxxx
LARK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxx
LARK_WIKI_TOKEN=your_wiki_token

# Telegram User API（https://my.telegram.org）
TELEGRAM_API_ID=12345678
TELEGRAM_API_HASH=your_api_hash
# 首次登录 scripts/login.py 时使用（含国家码，如 +8613800138000）
TELEGRAM_PHONE=
# 可选，国内需代理访问 Telegram（Clash 默认端口 7897）
# TELEGRAM_PROXY=socks5://127.0.0.1:7897

# DeepSeek（推荐）— https://platform.deepseek.com
DEEPSEEK_API_KEY=

# 或使用 OpenAI
# OPENAI_API_KEY=

# 通用备用名（任选其一即可）
# LLM_API_KEY=

# 飞书「主网上线」Webhook 鉴权（scripts/LARK_LIVE_WEBHOOK.md）
WORKFLOW_LIVE_WEBHOOK_SECRET=change-me-to-a-long-random-string

# 可选
LOG_LEVEL=INFO
